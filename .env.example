# MigLens environment variables — NAMES AND DESCRIPTIONS ONLY.
# Never commit real values (CONVENTIONS.md 12.4, SECURITY.md 10).
#
# The MVP core flow needs no secrets: OCR runs on the device, offer data stays in
# memory, and no analytics or database is enabled.

# Public site origin, used for PWA manifest metadata and canonical URLs.
# Example shape: https://<your-host>
NEXT_PUBLIC_SITE_URL=

# Optional: set to "1" to render the internal source-registry freshness page.
# Off by default. Never enable on a deployment that also serves production data.
NEXT_PUBLIC_SHOW_SOURCE_REGISTRY=
