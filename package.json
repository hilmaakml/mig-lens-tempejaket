{
  "name": "migranshield",
  "version": "0.1.0",
  "private": true,
  "description": "MigranShield — mobile web app (PWA) for evidence-based review of migrant-worker recruitment offers.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run vendor:ocr && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vendor:ocr": "node scripts/vendor-ocr-assets.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tesseract.js": "6.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@tailwindcss/oxide@4.1.14": true,
    "unrs-resolver@1.12.2": true
  }
}
